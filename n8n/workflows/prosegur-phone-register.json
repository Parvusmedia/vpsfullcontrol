      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nfunction normalizeSpainPhone(raw) {\n  if (raw == null || String(raw).trim() === '') {\n    return { valid: false, reason: 'empty' };\n  }\n  let d = String(raw).replace(/\\D/g, '');\n  if (d.startsWith('0034')) d = d.slice(2);\n  if (d.length === 9 && /^[6789]/.test(d)) d = '34' + d;\n  if (d.length === 11 && d.startsWith('34')) {\n    const national = d.slice(2);\n    if (/^[6789]\\d{8}$/.test(national)) {\n      return { valid: true, phone_digits: d };\n    }\n  }\n  return { valid: false, reason: 'invalid_spain' };\n}\n\nconst expected = $env.PROSEGUR_PHONE_REGISTER_SECRET;\nconst item = $input.first().json;\nconst headers = item.headers || {};\nconst got = headers['x-prosegur-register-secret'] || headers['X-Prosegur-Register-Secret'];\n\nif (!expected || !got || String(got) !== String(expected)) {\n  return [{ json: { route: 'unauthorized' } }];\n}\n\nconst body = item.body ?? item;\nconst phoneRaw = body.phone;\nconst source = String(body.source || 'unknown').slice(0, 120);\nconst norm = normalizeSpainPhone(phoneRaw);\n\nif (!norm.valid) {\n  return [{ json: { route: 'invalid', reason: norm.reason, source } }];\n}\n\nconst phone_digits = norm.phone_digits;\nconst phone_hash = crypto.createHash('sha256').update(phone_digits, 'utf8').digest('hex');\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    route: 'check_registry',\n    phone_digits,\n    phone_hash,\n    source,\n    claimed_at: now,\n    first_seen_at: now,\n    first_source: source\n  }\n}];"
      },
