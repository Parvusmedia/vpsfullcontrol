    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.phones) staticData.phones = {};\n\nconst prep = $('Prepare').first().json;\nconst phone = prep.phone_digits;\nconst now = new Date().toISOString();\n\nfunction duplicateResponse(existing) {\n  if (!staticData.phones[phone]) {\n    staticData.phones[phone] = {\n      phone_digits: phone,\n      phone_hash: existing.phone_hash || prep.phone_hash,\n      first_source: existing.first_source || prep.source,\n      first_seen_at: existing.first_seen_at || prep.first_seen_at,\n      claimed_at: existing.claimed_at || prep.claimed_at,\n      meta_synced_at: ''\n    };\n  }\n  return [{\n    json: {\n      ok: true,\n      recorded: true,\n      is_duplicate: true,\n      skip_data_table: true,\n      phone_digits: phone,\n      source: prep.source,\n      first_source: existing.first_source || prep.source,\n      phone_hash: existing.phone_hash || prep.phone_hash,\n      claimed_at: existing.claimed_at || prep.claimed_at,\n      first_seen_at: existing.first_seen_at || prep.first_seen_at,\n      duplicate_tag: 'duplicate',\n      is_duplicate_label: 'yes'\n    }\n  }];\n}\n\nconst tableRows = $('Get phone in table').all().map((i) => i.json).filter((r) => r && r.phone_digits === phone);\nconst tableRow = tableRows[0];\n\nif (staticData.phones[phone]) {\n  return duplicateResponse(staticData.phones[phone]);\n}\n\nif (tableRow) {\n  return duplicateResponse({\n    phone_hash: tableRow.phone_hash,\n    first_source: tableRow.first_source || tableRow.source,\n    first_seen_at: tableRow.first_seen_at || tableRow.received_at,\n    claimed_at: tableRow.first_seen_at || tableRow.received_at\n  });\n}\n\nstaticData.phones[phone] = {\n  phone_digits: phone,\n  phone_hash: prep.phone_hash,\n  first_source: prep.source,\n  first_seen_at: prep.first_seen_at,\n  claimed_at: prep.claimed_at,\n  meta_synced_at: ''\n};\n\nreturn [{\n  json: {\n    ok: true,\n    recorded: true,\n    is_duplicate: false,\n    skip_data_table: false,\n    phone_digits: phone,\n    phone_hash: prep.phone_hash,\n    source: prep.source,\n    claimed_at: prep.claimed_at,\n    first_seen_at: prep.first_seen_at,\n    first_source: prep.source\n  }\n}];"
