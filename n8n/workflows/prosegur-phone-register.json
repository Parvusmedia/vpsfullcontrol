    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.phones) staticData.phones = {};\nif (!staticData.duplicateEvents) staticData.duplicateEvents = [];\n\nconst prep = $input.first().json;\nconst phone = prep.phone_digits;\nconst now = new Date().toISOString();\n\nif (staticData.phones[phone]) {\n  const ex = staticData.phones[phone];\n  staticData.duplicateEvents.push({\n    event_key: `dup_${phone}_${now}`,\n    phone_digits: phone,\n    received_at: now,\n    source: prep.source,\n    first_source: ex.first_source,\n    first_seen_at: ex.first_seen_at,\n    action: 'duplicate_not_processed'\n  });\n  return [{\n    json: {\n      route: 'duplicate',\n      status: 'duplicate_not_processed',\n      phone_digits: phone,\n      source: prep.source,\n      first_source: ex.first_source,\n      first_seen_at: ex.first_seen_at,\n      message: 'duplicated phone, not processed'\n    }\n  }];\n}\n\nstaticData.phones[phone] = {\n  phone_digits: phone,\n  phone_hash: prep.phone_hash,\n  first_source: prep.source,\n  first_seen_at: prep.first_seen_at,\n  claimed_at: prep.claimed_at,\n  meta_synced_at: ''\n};\n\nreturn [{\n  json: {\n    route: 'claim',\n    status: 'claimed',\n    phone_digits: phone,\n    source: prep.source,\n    claimed_at: prep.claimed_at\n  }\n}];"
      },
