      "parameters": {
        "jsCode": "const prep = $('Prepare').first().json;\nconst item = $input.first().json || {};\nconst existing =\n  item.phone_digits === prep.phone_digits &&\n  (item.claimed_at || item.first_seen_at) &&\n  item.route !== 'check_registry';\n\nif (existing) {\n  const now = new Date().toISOString();\n  return [{\n    json: {\n      route: 'duplicate',\n      phone_digits: prep.phone_digits,\n      source: prep.source,\n      first_source: item.first_source || 'unknown',\n      first_seen_at: item.first_seen_at || item.claimed_at || now,\n      received_at: now,\n      event_key: `dup_${prep.phone_digits}_${now}`\n    }\n  }];\n}\n\nreturn [{ json: { ...prep, route: 'claim' } }];"
      },
