      "id": "fetch-applicants",
      "name": "Fetch Applicants (Unipile)"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst response = $('Fetch Applicants (Unipile)').first().json;\nconst applicants = Array.isArray(response.items) ? response.items : [];\n\nconst existingRows = $('Read Existing IDs').all().map((item) => item.json);\nconst existingIds = new Set();\n\nfor (const row of existingRows) {\n  const raw = row.application_id ?? row['application_id'] ?? row['Application ID'] ?? row['ID'] ?? Object.values(row)[0];\n  if (raw !== undefined && raw !== null && String(raw).trim() !== '') {\n    existingIds.add(String(raw).trim());\n  }\n}\n\nconst fresh = applicants.filter((applicant) => {\n  const id = String(applicant.id ?? applicant.application_id ?? '').trim();\n  return id && !existingIds.has(id);\n});\n\nif (!fresh.length) {\n  return [];\n}\n\nreturn fresh.map((applicant) => ({\n  json: {\n    applicant,\n    config: cfg,\n  },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        520
      ],
      "id": "split-filter-new",
      "name": "Split and Filter New"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $json.config;\nconst applicant = $json.applicant;\n\nconst screening = (applicant.screening_questions || [])\n  .map((q) => `P: ${q.question}\\nR: ${(q.answers || []).join(', ')}`)\n  .join('\\n');\n\nconst experiences = applicant.work_experience || applicant.experiences || [];\nconst education = applicant.education || [];\n\nconst expText = experiences\n  .slice(0, 8)\n  .map((e) => `- ${e.position || e.title || 'Sin cargo'} @ ${e.company || 'Sin empresa'}`)\n  .join('\\n');\n\nconst eduText = education\n  .slice(0, 5)\n  .map((e) => `- ${e.degree || ''} ${e.field_of_study || e.field || ''} (${e.school || ''})`)\n  .join('\\n');\n\nconst prompt = `Evalua este candidato para el puesto \"${cfg.job_title}\".\n\nCRITERIOS DEL PUESTO:\n${cfg.job_criteria}\n\nCANDIDATO:\nNombre: ${applicant.name || ''}\nHeadline: ${applicant.headline || ''}\nUbicacion: ${applicant.location || ''}\nPerfil: ${applicant.public_profile_url || applicant.profile_url || ''}\nEmail: ${applicant.email_address || ''}\nTelefono: ${applicant.phone_number || ''}\n\nEXPERIENCIA:\n${expText || 'No disponible'}\n\nEDUCACION:\n${eduText || 'No disponible'}\n\nPREGUNTAS DE FILTRO:\n${screening || 'Ninguna'}\n\nResponde SOLO JSON valido con esta estructura exacta:\n{\n  \"score\": 0,\n  \"recommendation\": \"entrevistar|descartar|dudoso\",\n  \"strengths\": [\"por que si 1\", \"por que si 2\"],\n  \"gaps\": [\"por que no 1\", \"por que no 2\"],\n  \"summary\": \"resumen breve\",\n  \"argument\": \"explicacion en 2-3 frases de por que si o por que no\"\n}`;\n\nreturn [\n  {\n    json: {\n      applicant,\n      config: cfg,\n      prompt,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        520
      ],
      "id": "prepare-ai-prompt",
      "name": "Prepare AI Prompt"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.config.openai_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.config.openai_model || 'gpt-4o-mini', temperature: 0.2, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Eres un reclutador experto. Responde unicamente JSON valido en espanol.' }, { role: 'user', content: $json.prompt } ] }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        520
      ],
      "id": "openai-analysis",
      "name": "OpenAI Analysis"
    },
    {
      "parameters": {
        "jsCode": "const source = $('Prepare AI Prompt').item.json;\nconst applicant = source.applicant;\nconst aiRaw = $input.first().json;\n\nlet parsed;\ntry {\n  const content = aiRaw.choices?.[0]?.message?.content || '{}';\n  parsed = JSON.parse(content);\n} catch (error) {\n  parsed = {\n    score: 0,\n    recommendation: 'dudoso',\n    strengths: [],\n    gaps: ['Error parseando respuesta IA'],\n    summary: 'No se pudo interpretar la respuesta del modelo',\n    argument: String(error.message || error),\n  };\n}\n\nconst applicationId = String(applicant.id ?? applicant.application_id ?? '');\nconst appliedAt = applicant.applied_at\n  ? new Date(Number(applicant.applied_at)).toISOString()\n  : '';\n\nreturn [\n  {\n    json: {\n      application_id: applicationId,\n      nombre: applicant.name || '',\n      perfil_url: applicant.public_profile_url || applicant.profile_url || '',\n      headline: applicant.headline || '',\n      email: applicant.email_address || '',\n      telefono: applicant.phone_number || '',\n      fecha_aplicacion: appliedAt,\n      score: parsed.score ?? 0,\n      recomendacion: parsed.recommendation || 'dudoso',\n      por_que_si: (parsed.strengths || []).join(' | '),\n      por_que_no: (parsed.gaps || []).join(' | '),\n      resumen: parsed.summary || '',\n      argumento: parsed.argument || parsed.summary || '',\n      fecha_analisis: new Date().toISOString(),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        520
