    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "ZI6qiUvYUVzuCJM6",
          "cachedResultName": "prosegur_phone_events"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "duplicate_tag",
              "condition": "eq",
              "keyValue": "new"
            },
            {
              "keyName": "phone_digits",
              "condition": "isNotEmpty"
            }
          ]
        },
        "returnAll": true
      },
      "id": "c1a1a1a1-0003-4000-8000-000000000003",
      "name": "Get new phones from table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [288, 240],
      "alwaysOutputData": true,
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.syncedPhones) staticData.syncedPhones = {};\n\nconst rows = $input.all()\n  .map((i) => i.json)\n  .filter((r) => r && r.phone_digits);\n\nconst pending = [];\nfor (const r of rows) {\n  const phone = String(r.phone_digits);\n  if (r.meta_synced_at && String(r.meta_synced_at).trim() !== '') continue;\n  if (staticData.syncedPhones[phone]) continue;\n\n  let phone_hash = r.phone_hash;\n  if (!phone_hash) {\n    phone_hash = crypto.createHash('sha256').update(phone, 'utf8').digest('hex');\n  }\n\n  pending.push({\n    phone_digits: phone,\n    phone_hash,\n    row_id: r.id,\n  });\n}\n\nif (pending.length === 0) {\n  return [{ json: { route: 'noop', pending_count: 0 } }];\n}\n\nreturn [{ json: { route: 'sync', pending, pending_count: pending.length } }];"
      },
      "id": "c1a1a1a1-0004-4000-8000-000000000004",
      "name": "Filter not synced to Meta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [544, 240]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "sync",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "sync"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "c1a1a1a1-0005-4000-8000-000000000005",
      "name": "Has pending",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [800, 240]
    },
    {
      "parameters": {
        "jsCode": "const pending = $input.first().json.pending || [];\nconst CHUNK = 5000;\nconst batches = [];\n\nfor (let i = 0; i < pending.length; i += CHUNK) {\n  const slice = pending.slice(i, i + CHUNK);\n  batches.push({\n    chunk_index: Math.floor(i / CHUNK),\n    phones: slice,\n    payload: {\n      schema: ['PHONE'],\n      data: slice.map((p) => [p.phone_hash]),\n    },\n  });\n}\n\nreturn batches.map((b) => ({ json: b }));"
      },
      "id": "c1a1a1a1-0006-4000-8000-000000000006",
      "name": "Build Meta batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1056, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v23.0/{{ $vars.PROSEGUR_META_CUSTOM_AUDIENCE_ID || '52551337752304' }}/users",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $vars.meta_systemusertoken_Adsmanager_PmediaES_Agent }}"
            },
            {
              "name": "payload",
              "value": "={{ JSON.stringify($json.payload) }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": false
            }
          }
        }
      },
      "id": "c1a1a1a1-0007-4000-8000-000000000007",
      "name": "Meta add users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1312, 160],
      "continueOnFail": false,
      "notes": "Token: $vars.meta_systemusertoken_Adsmanager_PmediaES_Agent (ads_management)"
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.syncedPhones) staticData.syncedPhones = {};\n\nconst batch = $('Build Meta batches').item.json;\nconst meta = $input.first().json;\n\nif (meta.error) {\n  throw new Error(`Meta API error: ${JSON.stringify(meta.error)}`);\n}\n\nconst now = new Date().toISOString();\nconst phones = batch.phones || [];\n\nfor (const p of phones) {\n  staticData.syncedPhones[p.phone_digits] = now;\n}\n\nreturn phones.map((p) => ({\n  json: {\n    phone_digits: p.phone_digits,\n    phone_hash: p.phone_hash,\n    meta_synced_at: now,\n    meta_num_received: meta.num_received,\n    meta_num_invalid_entries: meta.num_invalid_entries,\n  },\n}));"
      },
      "id": "c1a1a1a1-0008-4000-8000-000000000008",
      "name": "Mark synced",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1568, 160]
    },
    {
      "parameters": {
        "jsCode": "const tableRows = $('Get new phones from table').all()\n  .map((i) => i.json)\n  .filter((r) => r && r.phone_digits);\nconst byPhone = {};\nfor (const r of tableRows) {\n  byPhone[String(r.phone_digits)] = r;\n}\n\nconst sheetNow = new Date().toISOString();\n\nreturn $input.all().map((item) => {\n  const s = item.json;\n  const phone = String(s.phone_digits);\n  const r = byPhone[phone] || {};\n  const phoneE164 = phone.startsWith('+') ? phone : `+${phone}`;\n\n  return {\n    json: {\n      phone_digits: phone,\n      duplicate_tag: r.duplicate_tag || 'new',\n      is_duplicate: r.is_duplicate || 'no',\n      source: r.source || '',\n      first_source: r.first_source || r.source || '',\n      received_at: r.received_at || s.meta_synced_at || sheetNow,\n      first_seen_at: r.first_seen_at || r.received_at || '',\n      phone_hash: s.phone_hash || r.phone_hash || '',\n      meta_synced_at: s.meta_synced_at || sheetNow,\n      Phone: phoneE164,\n      google_synced_at: sheetNow,\n    },\n  };\n});"
      },
