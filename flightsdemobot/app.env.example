# Copy to /etc/flightsdemobot/app.env on the VPS (never commit real values).

TELEGRAM_BOT_TOKEN=
ACCESS_KEY=change-me-demo-key

# Optional: Amadeus self-service (if egress allows)
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_HOST=https://test.api.amadeus.com

# Quote tuning
QUOTE_TIMEOUT_SECONDS=12
QUOTE_MAX_CONCURRENT=4
MOCK_QUOTES=0

# Data directory for unlock sqlite
DATA_DIR=/var/lib/flightsdemobot
