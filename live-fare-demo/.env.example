# Public hostname for feed + demo (single vhost).
LIVE_FARE_DOMAIN=flights.pmediaplus.com

# Used by the updater when generating deeplinks.
DEEPLINK_BASE=https://example.com/book

# Feed browser/CDN cache in seconds. Must match nginx /fares/ Cache-Control.
# Change in deploy/nginx-live-fare-demo.conf (search TTL FEED) then reload nginx.
FEED_CACHE_MAX_AGE=30

# systemd timer interval is in deploy/live-fare-updater.timer (OnUnitActiveSec).
# Docker local loop uses this value.
UPDATE_INTERVAL_SECONDS=60
