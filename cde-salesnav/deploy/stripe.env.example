# Stripe billing for NavExport (/salesnav)
# Copy to: /var/www/vhosts/companydataenrichment.com/private/cde/stripe.env
# Mode: 640  Owner: companydataenrichment_*:psacln

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe catalog (NavExport credits — min pack €20 → 120 credits)
STRIPE_PRODUCT_ID=prod_VB9BUSTFvzzBRm
STRIPE_PRICE_ID=price_1UAmt1L0sc6a4STMnQu6BJcY
# Optional per-pack overrides: STRIPE_PRICE_ID_300=, STRIPE_PRICE_ID_600=, STRIPE_PRICE_ID_1200=

# Same as unipile.env
SALESNAV_SITE_ORIGIN=https://companydataenrichment.com

# Set to 0 to disable billing even if keys exist (optional)
# SALESNAV_BILLING_ENABLED=1
