# Site contact form + general notifications (local Postfix on Plesk).
# Copy to /var/www/vhosts/companydataenrichment.com/private/cde/mail.env

MAIL_TO=hello@companydataenrichment.com
MAIL_FROM=hello@companydataenrichment.com
MAIL_FROM_NAME=CompanyDataEnrichment
MAIL_TRANSPORT=local

# Optional legacy SMTP (set MAIL_TRANSPORT=smtp to enable):
