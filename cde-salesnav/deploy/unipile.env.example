# Unipile credentials for Sales Navigator export (/salesnav)
# Copy to: /var/www/vhosts/companydataenrichment.com/private/cde/unipile.env
# Owner: companydataenrichment_*:psacln  Mode: 640

UNIPILE_API_KEY=
UNIPILE_BASE_URL=https://api46.unipile.com:17682/api/v1

# Optional legacy fallback account (not used when users connect their own seat)
# UNIPILE_ACCOUNT_ID=

# Webhook auth token for /api/salesnav-unipile-notify.php (?token=...)
# Generate: openssl rand -hex 24
SALESNAV_NOTIFY_SECRET=

# Public site origin (no trailing slash)
SALESNAV_SITE_ORIGIN=https://companydataenrichment.com

# White-label Hosted Auth subdomain (CNAME → account.unipile.com; validate in Unipile dashboard)
SALESNAV_HOSTED_AUTH_DOMAIN=connect.companydataenrichment.com
