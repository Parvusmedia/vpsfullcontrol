# Copia a config/n8n.local.env y rellena los valores.
# Este archivo NO contiene secretos y sí se versiona en git.

N8N_URL=https://pmedia.app.n8n.cloud
N8N_MCP_ENDPOINT=https://pmedia.app.n8n.cloud/mcp-server/http

# JWT public-api o clave REST (n8n_api_...). Usado por scripts/n8n y deploy.
N8N_API_KEY=

# Opcional: si tienes tokens separados, descomenta:
# N8N_REST_API_KEY=
# N8N_MCP_TOKEN=
