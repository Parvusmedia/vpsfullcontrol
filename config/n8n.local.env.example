# Copia a config/n8n.local.env y rellena los valores.
# Este archivo NO contiene secretos y sí se versiona en git.

N8N_URL=https://pmedia.app.n8n.cloud
N8N_MCP_ENDPOINT=https://pmedia.app.n8n.cloud/mcp-server/http

# REST / deploy (Settings → API → JWT con aud public-api, o clave n8n_api_...)
N8N_API_KEY=

# MCP (Settings → Instance-level MCP → Access token, aud mcp-server-api)
# Distinto del token REST. Copiar desde la pantalla "Connect to MCP server".
N8N_MCP_TOKEN=

# Opcional: si prefieres separar REST explícitamente
# N8N_REST_API_KEY=
