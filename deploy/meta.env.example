# Meta Marketing API (Parvus partner → cliente BM compartido)
# Copiar a un path fuera de git (p. ej. /opt/apps/private/<cliente>/meta.env) y cargar en el shell del agente.
# Nunca commitear valores reales.

# Token de system user de Parvus Media (BM 688106874654286) con acceso a activos del cliente.
META_ACCESS_TOKEN=

# Cuenta publicitaria del cliente (sin prefijo act_)
META_AD_ACCOUNT_ID=476956206434765

# Opcional: IDs de referencia / validación
META_CLIENT_BUSINESS_ID=461966487998679
META_PARTNER_BUSINESS_ID=688106874654286

# Versión Graph API (ajustar si Meta depreca)
META_GRAPH_VERSION=v22.0

# URL de política de privacidad para formularios de leads (obligatoria al crear forms)
META_PRIVACY_POLICY_URL=https://example.com/privacy
