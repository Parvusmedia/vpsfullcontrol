# Archivo de configuración del servidor (nombre interno). En la UI solo aparece Ngaged.
PUBLORA_API_KEY=sk_your_key_here
NGAGED_ADMIN_KEY=change-me-long-random
# Cuenta owner inicial (solo si aún no existe admins.json):
# NGAGED_BOOTSTRAP_ADMIN_EMAIL=admin@tuempresa.com
# NGAGED_BOOTSTRAP_ADMIN_PASSWORD=contraseña-larga-inicial
# NGAGED_BOOTSTRAP_ADMIN_NAME=Tu nombre
# Verificación 2FA por email en /login (1=activo, 0=desactivar solo dev):
NGAGED_ADMIN_2FA=1
# Google Sign-In (opcional):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Legacy alias (optional): GAGGLE_DEMO_ADMIN_KEY=
NGAGED_APP_URL=https://ngaged.app
NGAGED_MAIL_FROM="Ngaged <alerts@pmediaplus.com>"
# SMTP Plesk (recomendado en producción):
NGAGED_SMTP_HOST=mail.pmediaplus.com
NGAGED_SMTP_PORT=587
NGAGED_SMTP_SECURE=tls
NGAGED_SMTP_USER=alerts@pmediaplus.com
NGAGED_SMTP_PASSWORD=
NGAGED_SIGNING_SECRET=change-me-long-random
