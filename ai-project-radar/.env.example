# AI Project Radar — copy to .env and fill in values.
# Never commit the real .env file.

OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SEARCH_API_KEY=

# mock | serper | tavily | bing
SEARCH_PROVIDER=serper

# Set true to run the full pipeline without consuming APIs.
USE_MOCKS=false

OPENAI_MODEL=gpt-4o-mini
DATABASE_PATH=data/radar.db
SCAN_INTERVAL_HOURS=1
MIN_NOTIFY_SCORE=8.0
MAX_AGE_HOURS=24
MAX_AGE_EXCEPTIONAL_HOURS=72
QUERIES_PER_SCAN=12

# Disable background jobs in tests.
ENABLE_SCHEDULER=true
ENABLE_TELEGRAM_POLLING=true
