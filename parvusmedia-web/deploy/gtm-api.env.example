# Google Tag Manager API (service account). Copy to VPS only — never commit real values.
# Path on parvus-vps: /opt/apps/private/parvusmedia-web/gtm-api.env

GOOGLE_APPLICATION_CREDENTIALS=/opt/apps/private/parvusmedia-web/gtm-service-account.json

# Numeric IDs (Tag Manager UI → Admin, or run: scripts/gtm accounts / containers)
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=
GTM_WORKSPACE_ID=

# Public container ID (reference only)
GTM_PUBLIC_ID=GTM-T9JWZZ3Q
